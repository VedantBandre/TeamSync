# This file documents variables; Django does not automatically load .env files.
# Development defaults work without any environment file.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false
DB_ENGINE=sqlite

# Production: set DJANGO_ENV=production and DJANGO_DEBUG=false.
# Generate DJANGO_SECRET_KEY privately; at least 50 random characters.
# Configure actual HTTPS origins and explicit API host names above.
# PostgreSQL is mandatory in production; TLS defaults to require.
# DB_ENGINE=postgresql
# DB_NAME=teamsync
# DB_USER=teamsync
# DB_PASSWORD=<set privately>
# DB_HOST=<database host>
# DB_PORT=5432
# DB_SSLMODE=require

# Email recovery: operator-owned frontend URL, never an address from request data.
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Local emails go to backend/.emails/ (private; ignored by Git).
EMAIL_DELIVERY=file
DEFAULT_FROM_EMAIL=teamsync@localhost
# Email-enabled production requires EMAIL_DELIVERY=resend and FRONTEND_ORIGIN=https://<frontend>.
# For first deployment without an email provider, explicitly set EMAIL_DELIVERY=disabled.
# Recovery requests then fail clearly; sign-in and authenticated password changes still work.
# On Render, its RENDER_EXTERNAL_HOSTNAME is automatically added to allowed hosts.
# DEFAULT_FROM_EMAIL=teamsync@<your verified sending domain>
# RESEND_API_KEY=<set privately in Render>
